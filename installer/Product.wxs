<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MirageSSD" Manufacturer="MirageSSD" Version="$(var.ProductVersion)" ProductCode="$(var.ProductCode)" UpgradeCode="D9208A1A-218D-4C80-AB41-704DFF8B3485" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer MirageSSD version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <PropertyRef Id="WINDOWS_BUILD" />
    <PropertyRef Id="WINFSP_INSTALLED" />
    <PropertyRef Id="WINFSP_VERSION" />
    <Launch Condition="WINDOWS_BUILD &gt;= 22000" Message="MirageSSD requires Windows 11 build 22000 or newer." />
    <Launch Condition="WINFSP_INSTALLED AND WINFSP_VERSION = &quot;2.1.25156&quot;" Message="MirageSSD requires the signed WinFsp 2.1.25156 runtime." />
    <Feature Id="Main" Title="MirageSSD" Level="1">
      <ComponentGroupRef Id="MirageComponents" />
    </Feature>
    <CustomAction Id="BlockUnsafeUninstall" FileRef="MirageService" ExeCommand="--uninstall-check &quot;[CommonAppDataFolder]MirageSSD&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <!-- Windows Installer checks for in-use files (InstallValidate) before it
         stops services, so on an upgrade the previous service's mounted
         filesystem hosts and the open app window would trigger the
         "Files in use" prompt. Quiesce them first: stopping the service
         unmounts every volume cleanly; the app is closed and relaunched by
         the setup bundle when the upgrade finishes. A service registration
         left behind by an interrupted install (no product record, but the
         SCM entry exists) would make ServiceInstall fail with error 1923, so
         it is removed as well. All three run on every install and are best
         effort: on a clean machine there is nothing to stop or delete. -->
    <CustomAction Id="StopPreviousService" Directory="SystemFolder" ExeCommand="net.exe stop MirageSSD" Execute="immediate" Return="ignore" />
    <CustomAction Id="ClosePreviousApp" Directory="SystemFolder" ExeCommand="taskkill.exe /F /IM mirage-ui.exe /IM mirage-fs.exe /IM mirage-service.exe" Execute="immediate" Return="ignore" />
    <CustomAction Id="DeleteOrphanService" Directory="SystemFolder" ExeCommand="sc.exe delete MirageSSD" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopPreviousService" Before="ClosePreviousApp" Condition="NOT REMOVE" />
      <Custom Action="ClosePreviousApp" Before="DeleteOrphanService" Condition="NOT REMOVE" />
      <Custom Action="DeleteOrphanService" Before="InstallValidate" Condition="NOT REMOVE" />
      <Custom Action="BlockUnsafeUninstall" Before="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
