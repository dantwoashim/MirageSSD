#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MIRAGE_RESOURCE_VERSION@,0
 PRODUCTVERSION @MIRAGE_RESOURCE_VERSION@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MirageSSD filesystem host\0"
            VALUE "FileVersion", "@MIRAGE_HOST_VERSION@\0"
            VALUE "ProductName", "MirageSSD\0"
            VALUE "ProductVersion", "@MIRAGE_HOST_VERSION@\0"
            VALUE "OriginalFilename", "mirage-fs.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
