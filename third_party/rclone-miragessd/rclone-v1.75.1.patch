+// Chflags persists Windows file attributes that cloud object stores do not
+// represent themselves. WinFsp maps these BSD-style flags to the native
+// read-only, hidden, system, and archive attributes shown by Explorer.
+func (fsys *FS) Chflags(filePath string, flags uint32) (errc int) {
+	defer log.Trace(filePath, "flags=0x%X", flags)("errc=%d", &errc)
+	if runtime.GOOS != "windows" {
+		return -fuse.ENOSYS
+	}
+	if _, errc = fsys.lookupNode(filePath); errc != 0 {
+		return errc
+	}
+	if err := fsys.attributes.set(filePath, flags); err != nil {
+		fs.Errorf(filePath, "failed to persist Windows attributes: %v", err)
+		return -fuse.EIO
+	}
+	return 0
 }
 
