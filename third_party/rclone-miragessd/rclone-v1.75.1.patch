diff --git a/cmd/cmount/attributes.go b/cmd/cmount/attributes.go
new file mode 100644
index 000000000..330319d4d
--- /dev/null
+++ b/cmd/cmount/attributes.go
@@ -0,0 +1,475 @@
+//go:build cmount && ((linux && cgo) || (darwin && cgo) || (freebsd && cgo) || (openbsd && cgo) || windows)
+
+package cmount
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+
+	"github.com/rclone/rclone/fs"
+)
+
+const (
+	attributeStoreEnvironment    = "MIRAGESSD_ATTRIBUTES_FILE"
+	attributeBindingEnvironment  = "MIRAGESSD_ATTRIBUTES_BINDING"
+	attributeStoreVersion        = 3
+	legacyJournalVersion         = 2
+	maximumAttributeStoreSize    = 256 << 20
+	attributeCompactionThreshold = 32 << 20
+	maximumBindingLength         = 128
+)
+
+type attributeStoreRecord struct {
+	FormatVersion int    `json:"format_version"`
+	Binding       string `json:"binding,omitempty"`
+}
+
+type legacyAttributeStoreRecord struct {
+	FormatVersion int               `json:"format_version"`
+	Entries       map[string]uint32 `json:"entries"`
+}
+
+type attributeOperation struct {
+	Operation string            `json:"op"`
+	Path      string            `json:"path,omitempty"`
+	NewPath   string            `json:"new_path,omitempty"`
+	Flags     uint32            `json:"flags,omitempty"`
+	Entries   map[string]uint32 `json:"entries,omitempty"`
+}
+
+type attributeStore struct {
+	mu              sync.RWMutex
+	path            string
+	binding         string
+	entries         map[string]uint32
+	journalBytes    int64
+	initialized     bool
+	unboundJournal  bool
+	loadErr         error
+}
+
+// newAttributeStoreFromEnvironment opens the per-root attribute journal. The
+// binding from MIRAGESSD_ATTRIBUTES_BINDING identifies the account and Drive
+// root this store belongs to; a journal bound to a different identity is
+// rejected rather than replayed.
+func newAttributeStoreFromEnvironment() *attributeStore {
+	store := &attributeStore{entries: make(map[string]uint32)}
+	store.path = os.Getenv(attributeStoreEnvironment)
+	store.binding = os.Getenv(attributeBindingEnvironment)
+	if len(store.binding) > maximumBindingLength || strings.IndexFunc(store.binding, func(r rune) bool { return r < 0x20 || r > 0x7e }) >= 0 {
+		store.loadErr = errors.New("attribute store binding is invalid")
+		return store
+	}
+	if store.path == "" {
+		return store
+	}
+	info, err := os.Stat(store.path)
+	if errors.Is(err, os.ErrNotExist) {
+		return store
+	}
+	if err != nil {
+		store.loadErr = err
+		return store
+	}
+	if info.Size() > maximumAttributeStoreSize {
+		store.loadErr = errors.New("attribute store exceeds size limit")
+		return store
+	}
+	data, err := os.ReadFile(store.path)
+	if err != nil {
+		store.loadErr = err
+		return store
+	}
+	if store.loadLegacy(data) {
+		if err := store.compactLocked(); err != nil {
+			store.loadErr = err
+		}
+		return store
+	}
+	if err := store.loadJournal(data); err != nil {
+		store.loadErr = err
+		return store
+	}
+	store.initialized = true
+	store.journalBytes = info.Size()
+	// Repair an unterminated tail before any append, including valid JSON
+	// missing its newline. Never concatenate the next operation onto it.
+	if store.unboundJournal || info.Size() >= attributeCompactionThreshold || !bytes.HasSuffix(data, []byte{'\n'}) {
+		if err := store.compactLocked(); err != nil {
+			store.loadErr = err
+		}
+	}
+	return store
+}
+
+func (store *attributeStore) loadLegacy(data []byte) bool {
+	var record legacyAttributeStoreRecord
+	if json.Unmarshal(data, &record) != nil || record.FormatVersion != 1 || record.Entries == nil {
+		return false
+	}
+	store.entries = record.Entries
+	return true
+}
+
+func (store *attributeStore) loadJournal(data []byte) error {
+	lines := bytes.Split(data, []byte{'\n'})
+	if len(lines) == 0 || len(bytes.TrimSpace(lines[0])) == 0 {
+		return errors.New("attribute journal is empty")
+	}
+	var header attributeStoreRecord
+	if err := json.Unmarshal(lines[0], &header); err != nil {
+		return err
+	}
+	switch header.FormatVersion {
+	case attributeStoreVersion:
+		if header.Binding != store.binding {
+			return errors.New("attribute store belongs to a different account or root")
+		}
+	case legacyJournalVersion:
+		if header.Binding != "" {
+			return errors.New("attribute journal header is invalid")
+		}
+		// The launcher places a version-2 journal at this account-bound path
+		// only after verifying its ownership, so it is adopted and re-written
+		// with the current binding below.
+		store.unboundJournal = true
+	default:
+		return errors.New("unsupported attribute store format")
+	}
+	for index, line := range lines[1:] {
+		if len(bytes.TrimSpace(line)) == 0 {
+			continue
+		}
+		var operation attributeOperation
+		if err := json.Unmarshal(line, &operation); err != nil {
+			if index == len(lines)-2 && !bytes.HasSuffix(data, []byte{'\n'}) {
+				break
+			}
+			return err
+		}
+		if err := store.replayLocked(operation); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func normalizeAttributePath(value string) string {
+	value = strings.TrimSuffix(strings.ReplaceAll(value, `\`, "/"), "/")
+	if value == "" {
+		value = "/"
+	}
+	if !strings.HasPrefix(value, "/") {
+		value = "/" + value
+	}
+	if runtime.GOOS == "windows" {
+		value = strings.ToLower(value)
+	}
+	return value
+}
+
+func (store *attributeStore) get(filePath string) uint32 {
+	if store == nil || store.path == "" || store.loadErr != nil {
+		return 0
+	}
+	store.mu.RLock()
+	defer store.mu.RUnlock()
+	return store.entries[normalizeAttributePath(filePath)]
+}
+
+func (store *attributeStore) set(filePath string, flags uint32) error {
+	if store == nil || store.path == "" {
+		return nil
+	}
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	if store.loadErr != nil {
+		return store.loadErr
+	}
+	key := normalizeAttributePath(filePath)
+	previous, existed := store.entries[key]
+	if flags == 0 {
+		delete(store.entries, key)
+	} else {
+		store.entries[key] = flags
+	}
+	err := store.appendLocked(attributeOperation{
+		Operation: "set",
+		Path:      key,
+		Flags:     flags,
+	})
+	if err != nil {
+		if existed {
+			store.entries[key] = previous
+		} else {
+			delete(store.entries, key)
+		}
+	}
+	return err
+}
+
+func (store *attributeStore) remove(filePath string) error {
+	if store == nil || store.path == "" {
+		return nil
+	}
+	if store.loadErr != nil {
+		return store.loadErr
+	}
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	prefix := normalizeAttributePath(filePath)
+	removed := store.removePrefixLocked(prefix)
+	if err := store.appendLocked(attributeOperation{Operation: "remove", Path: prefix}); err != nil {
+		for key, flags := range removed {
+			store.entries[key] = flags
+		}
+		return err
+	}
+	return nil
+}
+
+func (store *attributeStore) rename(oldPath string, newPath string) error {
+	if store == nil || store.path == "" {
+		return nil
+	}
+	if store.loadErr != nil {
+		return store.loadErr
+	}
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	oldPrefix := normalizeAttributePath(oldPath)
+	newPrefix := normalizeAttributePath(newPath)
+	snapshot := store.snapshotSubtreesLocked(oldPrefix, newPrefix)
+	store.renamePrefixLocked(oldPrefix, newPrefix)
+	if err := store.appendLocked(attributeOperation{
+		Operation: "rename",
+		Path:      oldPrefix,
+		NewPath:   newPrefix,
+	}); err != nil {
+		store.restoreSubtreesLocked(snapshot, oldPrefix, newPrefix)
+		return err
+	}
+	return nil
+}
+
+func (store *attributeStore) replayLocked(operation attributeOperation) error {
+	switch operation.Operation {
+	case "snapshot":
+		if operation.Entries == nil {
+			return errors.New("attribute snapshot has no entries")
+		}
+		store.entries = operation.Entries
+	case "set":
+		if operation.Path == "" {
+			return errors.New("attribute set has no path")
+		}
+		if operation.Flags == 0 {
+			delete(store.entries, operation.Path)
+		} else {
+			store.entries[operation.Path] = operation.Flags
+		}
+	case "remove":
+		if operation.Path == "" {
+			return errors.New("attribute removal has no path")
+		}
+		store.removePrefixLocked(operation.Path)
+	case "rename":
+		if operation.Path == "" || operation.NewPath == "" {
+			return errors.New("attribute rename has an incomplete path")
+		}
+		store.renamePrefixLocked(operation.Path, operation.NewPath)
+	default:
+		return errors.New("attribute journal contains an unknown operation")
+	}
+	return nil
+}
+
+// removePrefixLocked deletes the entry at prefix and every entry below it,
+// returning the removed state so a failed journal append can be undone.
+func (store *attributeStore) removePrefixLocked(prefix string) map[string]uint32 {
+	childPrefix := prefix + "/"
+	var removed map[string]uint32
+	for key, flags := range store.entries {
+		if key == prefix || strings.HasPrefix(key, childPrefix) {
+			if removed == nil {
+				removed = make(map[string]uint32)
+			}
+			removed[key] = flags
+			delete(store.entries, key)
+		}
+	}
+	return removed
+}
+
+func (store *attributeStore) renamePrefixLocked(oldPrefix string, newPrefix string) {
+	if oldPrefix == newPrefix {
+		return
+	}
+	childPrefix := oldPrefix + "/"
+	moved := make(map[string]uint32)
+	for key, flags := range store.entries {
+		if key == oldPrefix {
+			moved[newPrefix] = flags
+			delete(store.entries, key)
+		} else if strings.HasPrefix(key, childPrefix) {
+			moved[newPrefix+strings.TrimPrefix(key, oldPrefix)] = flags
+			delete(store.entries, key)
+		}
+	}
+	// Replacement inherits only the source metadata, never the old target's.
+	store.removePrefixLocked(newPrefix)
+	for key, flags := range moved {
+		store.entries[key] = flags
+	}
+}
+
+// snapshotSubtreesLocked copies every entry at or below each prefix.
+func (store *attributeStore) snapshotSubtreesLocked(prefixes ...string) map[string]uint32 {
+	snapshot := make(map[string]uint32)
+	for _, prefix := range prefixes {
+		childPrefix := prefix + "/"
+		for key, flags := range store.entries {
+			if key == prefix || strings.HasPrefix(key, childPrefix) {
+				snapshot[key] = flags
+			}
+		}
+	}
+	return snapshot
+}
+
+// restoreSubtreesLocked reverts the current subtree state under each prefix to
+// exactly the recorded snapshot.
+func (store *attributeStore) restoreSubtreesLocked(snapshot map[string]uint32, prefixes ...string) {
+	for _, prefix := range prefixes {
+		store.removePrefixLocked(prefix)
+	}
+	for key, flags := range snapshot {
+		store.entries[key] = flags
+	}
+}
+
+func (store *attributeStore) appendLocked(operation attributeOperation) error {
+	if !store.initialized {
+		if err := store.compactLocked(); err != nil {
+			return err
+		}
+	}
+	data, err := json.Marshal(operation)
+	if err != nil {
+		return err
+	}
+	data = append(data, '\n')
+	file, err := os.OpenFile(store.path, os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	_, err = file.Write(data)
+	closeErr := file.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	store.journalBytes += int64(len(data))
+	// A mounted session appends for days; compact once the journal crosses
+	// the threshold instead of growing until the next mount. A failed
+	// compaction is not an operation failure: the append is already durable,
+	// so the in-memory state must not be rolled back.
+	if store.journalBytes >= attributeCompactionThreshold {
+		if err := store.compactLocked(); err != nil {
+			fs.Errorf(nil, "attribute journal compaction failed, retrying on a later update: %v", err)
+		}
+	}
+	return nil
+}
+
+// flush makes the attribute journal durable at a clean unmount. Individual
+// updates deliberately use the Windows write cache: forcing a physical flush
+// for every SetFileAttributes call serializes Explorer's small-file copy path.
+func (store *attributeStore) flush() error {
+	if store == nil || store.path == "" {
+		return nil
+	}
+	store.mu.Lock()
+	defer store.mu.Unlock()
+	if store.loadErr != nil {
+		return store.loadErr
+	}
+	if !store.initialized {
+		return nil
+	}
+	file, err := os.OpenFile(store.path, os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	syncErr := file.Sync()
+	closeErr := file.Close()
+	if syncErr != nil {
+		return syncErr
+	}
+	return closeErr
+}
+
+func (store *attributeStore) compactLocked() error {
+	header, err := json.Marshal(attributeStoreRecord{
+		FormatVersion: attributeStoreVersion,
+		Binding:       store.binding,
+	})
+	if err != nil {
+		return err
+	}
+	snapshot, err := json.Marshal(attributeOperation{
+		Operation: "snapshot",
+		Entries:   store.entries,
+	})
+	if err != nil {
+		return err
+	}
+	data := make([]byte, 0, len(header)+len(snapshot)+2)
+	data = append(data, header...)
+	data = append(data, '\n')
+	data = append(data, snapshot...)
+	data = append(data, '\n')
+	if len(data) > maximumAttributeStoreSize {
+		return errors.New("attribute store exceeds size limit")
+	}
+	if err := os.MkdirAll(filepath.Dir(store.path), 0o700); err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(store.path), ".miragessd-attributes-*.tmp")
+	if err != nil {
+		return err
+	}
+	temporaryPath := temporary.Name()
+	committed := false
+	defer func() {
+		_ = temporary.Close()
+		if !committed {
+			_ = os.Remove(temporaryPath)
+		}
+	}()
+	if _, err = temporary.Write(data); err != nil {
+		return err
+	}
+	if err = temporary.Sync(); err != nil {
+		return err
+	}
+	if err = temporary.Close(); err != nil {
+		return err
+	}
+	if err = os.Rename(temporaryPath, store.path); err != nil {
+		return err
+	}
+	committed = true
+	store.initialized = true
+	store.unboundJournal = false
+	store.journalBytes = int64(len(data))
+	return nil
+}
diff --git a/cmd/cmount/attributes_test.go b/cmd/cmount/attributes_test.go
new file mode 100644
index 000000000..1df2c9617
--- /dev/null
+++ b/cmd/cmount/attributes_test.go
@@ -0,0 +1,271 @@
+//go:build cmount && windows
+
+package cmount
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestAttributeStoreJournalRoundTrip(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	store := newAttributeStoreFromEnvironment()
+	if err := store.set(`/Folder/Hidden.txt`, 0x9800); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.set(`/Folder/Second.txt`, 0x800); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.rename(`/Folder`, `/Renamed`); err != nil {
+		t.Fatal(err)
+	}
+	if got := store.get(`/RENAMED/HIDDEN.TXT`); got != 0x9800 {
+		t.Fatalf("renamed flags = 0x%X", got)
+	}
+	reloaded := newAttributeStoreFromEnvironment()
+	if got := reloaded.get(`/renamed/hidden.txt`); got != 0x9800 {
+		t.Fatalf("reloaded flags = 0x%X", got)
+	}
+	if err := reloaded.remove(`/renamed`); err != nil {
+		t.Fatal(err)
+	}
+	if err := reloaded.flush(); err != nil {
+		t.Fatal(err)
+	}
+	if got := newAttributeStoreFromEnvironment().get(`/renamed/hidden.txt`); got != 0 {
+		t.Fatalf("removed flags = 0x%X", got)
+	}
+}
+
+func TestAttributeStoreMigratesLegacySnapshot(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	legacy := `{"format_version":1,"entries":{"/hidden":32768}}`
+	if err := os.WriteFile(path, []byte(legacy), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	store := newAttributeStoreFromEnvironment()
+	if store.loadErr != nil {
+		t.Fatal(store.loadErr)
+	}
+	if got := store.get(`/hidden`); got != 32768 {
+		t.Fatalf("migrated flags = %d", got)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(string(data), `{"format_version":3}`+"\n") {
+		t.Fatalf("legacy store was not migrated: %s", data)
+	}
+}
+
+func TestAttributeStoreIgnoresOnlyTruncatedFinalRecord(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	data := fmt.Sprintf(
+		"%s\n%s\n%s",
+		`{"format_version":2}`,
+		`{"op":"set","path":"/kept","flags":32768}`,
+		`{"op":"set","path":"/truncated"`,
+	)
+	if err := os.WriteFile(path, []byte(data), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	store := newAttributeStoreFromEnvironment()
+	if store.loadErr != nil {
+		t.Fatal(store.loadErr)
+	}
+	if got := store.get(`/kept`); got != 32768 {
+		t.Fatalf("flags before truncated tail = %d", got)
+	}
+	if err := store.set(`/new`, 2); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.flush(); err != nil {
+		t.Fatal(err)
+	}
+	reloaded := newAttributeStoreFromEnvironment()
+	if reloaded.loadErr != nil || reloaded.get(`/kept`) != 32768 || reloaded.get(`/new`) != 2 {
+		t.Fatalf("repaired journal did not survive append and reload: %v", reloaded.loadErr)
+	}
+}
+
+func TestAttributeStoreReplacementClearsDestination(t *testing.T) {
+	t.Setenv(attributeStoreEnvironment, filepath.Join(t.TempDir(), "attributes.jsonl"))
+	store := newAttributeStoreFromEnvironment()
+	if err := store.set(`/target`, 2); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.rename(`/source`, `/target`); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.flush(); err != nil {
+		t.Fatal(err)
+	}
+	reloaded := newAttributeStoreFromEnvironment()
+	if reloaded.loadErr != nil || store.get(`/target`) != 0 || reloaded.get(`/target`) != 0 {
+		t.Fatalf("replacement retained destination attributes: %v", reloaded.loadErr)
+	}
+}
+
+func TestAttributeStoreRenameAppendFailureRestoresMemory(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	store := newAttributeStoreFromEnvironment()
+	if err := store.set(`/old`, 32768); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.set(`/old/child`, 2); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.set(`/target`, 4); err != nil {
+		t.Fatal(err)
+	}
+	// A directory path makes every journal append fail without touching the
+	// original file.
+	store.path = dir
+	if err := store.rename(`/old`, `/target`); err == nil {
+		t.Fatal("expected append error")
+	}
+	if got := store.get(`/old`); got != 32768 {
+		t.Fatalf("failed rename lost source flags: 0x%X", got)
+	}
+	if got := store.get(`/old/child`); got != 2 {
+		t.Fatalf("failed rename lost child flags: 0x%X", got)
+	}
+	if got := store.get(`/target`); got != 4 {
+		t.Fatalf("failed rename cleared destination flags: 0x%X", got)
+	}
+	fresh := newAttributeStoreFromEnvironment()
+	if fresh.get(`/old`) != 32768 || fresh.get(`/old/child`) != 2 || fresh.get(`/target`) != 4 {
+		t.Fatal("journal diverged from restored memory state")
+	}
+}
+
+func TestAttributeStoreRemoveAppendFailureRestoresMemory(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	store := newAttributeStoreFromEnvironment()
+	if err := store.set(`/gone`, 32768); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.set(`/gone/child`, 2); err != nil {
+		t.Fatal(err)
+	}
+	store.path = dir
+	if err := store.remove(`/gone`); err == nil {
+		t.Fatal("expected append error")
+	}
+	if got := store.get(`/gone`); got != 32768 {
+		t.Fatalf("failed remove lost flags: 0x%X", got)
+	}
+	if got := store.get(`/gone/child`); got != 2 {
+		t.Fatalf("failed remove lost child flags: 0x%X", got)
+	}
+	fresh := newAttributeStoreFromEnvironment()
+	if fresh.get(`/gone`) != 32768 || fresh.get(`/gone/child`) != 2 {
+		t.Fatal("journal diverged from restored memory state")
+	}
+}
+
+func TestAttributeStoreCompactsDuringSession(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	store := newAttributeStoreFromEnvironment()
+	if err := store.set(`/old`, 32768); err != nil {
+		t.Fatal(err)
+	}
+	// Simulate a long-running session whose journal crossed the threshold.
+	store.journalBytes = attributeCompactionThreshold
+	if err := store.set(`/new`, 2); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Size() >= attributeCompactionThreshold {
+		t.Fatalf("runtime append left %d uncompactd bytes", info.Size())
+	}
+	fresh := newAttributeStoreFromEnvironment()
+	if fresh.loadErr != nil || fresh.get(`/old`) != 32768 || fresh.get(`/new`) != 2 {
+		t.Fatalf("compacted journal lost entries: %v", fresh.loadErr)
+	}
+}
+
+func TestAttributeStoreRejectsForeignBinding(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	t.Setenv(attributeBindingEnvironment, "account-a-root")
+	store := newAttributeStoreFromEnvironment()
+	if err := store.set(`/hidden`, 32768); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.flush(); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(attributeBindingEnvironment, "account-b-root")
+	rebound := newAttributeStoreFromEnvironment()
+	if rebound.loadErr == nil {
+		t.Fatal("store accepted another account's binding")
+	}
+	if err := rebound.set(`/other`, 2); err == nil {
+		t.Fatal("foreign store accepted a write")
+	}
+	t.Setenv(attributeBindingEnvironment, "account-a-root")
+	restored := newAttributeStoreFromEnvironment()
+	if restored.loadErr != nil || restored.get(`/hidden`) != 32768 {
+		t.Fatalf("original binding could not reload its store: %v", restored.loadErr)
+	}
+}
+
+func TestAttributeStoreAdoptsUnboundJournal(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "attributes.jsonl")
+	t.Setenv(attributeStoreEnvironment, path)
+	data := fmt.Sprintf(
+		"%s\n%s\n",
+		`{"format_version":2}`,
+		`{"op":"set","path":"/kept","flags":32768}`,
+	)
+	if err := os.WriteFile(path, []byte(data), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(attributeBindingEnvironment, "account-a-root")
+	store := newAttributeStoreFromEnvironment()
+	if store.loadErr != nil {
+		t.Fatal(store.loadErr)
+	}
+	if got := store.get(`/kept`); got != 32768 {
+		t.Fatalf("adopted journal lost flags: 0x%X", got)
+	}
+	header, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(string(header), `{"format_version":3,"binding":"account-a-root"}`) {
+		t.Fatalf("adopted journal was not rebound: %s", header)
+	}
+}
+
+func BenchmarkAttributeStoreSet(b *testing.B) {
+	path := filepath.Join(b.TempDir(), "attributes.jsonl")
+	b.Setenv(attributeStoreEnvironment, path)
+	store := newAttributeStoreFromEnvironment()
+	b.ResetTimer()
+	for index := 0; index < b.N; index++ {
+		if err := store.set(fmt.Sprintf(`/file-%d`, index), 0x8000); err != nil {
+			b.Fatal(err)
+		}
+	}
+	b.StopTimer()
+	if err := store.flush(); err != nil {
+		b.Fatal(err)
+	}
+}
